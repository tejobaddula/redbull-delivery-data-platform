# Copy to .env and fill in. .env is gitignored.
# Account identifier: from Snowsight URL app.snowflake.com/<ORG>/<ACCOUNT>/  -> use "ORG-ACCOUNT"
# or the legacy "xy12345.us-east-1" form.
SNOWFLAKE_ACCOUNT=ORG-ACCOUNT
SNOWFLAKE_USER=your_username
SNOWFLAKE_PASSWORD=
# Role/warehouse/db used to run the DDL + load. ACCOUNTADMIN is fine for initial setup.
SNOWFLAKE_ROLE=ACCOUNTADMIN
SNOWFLAKE_WAREHOUSE=RB_LOAD_WH
SNOWFLAKE_DATABASE=REDBULL_DELIVERY

# Local root of the raw case-study data (contains outlet/ portfolio/ matching/).
RAW_DATA_DIR=/Users/tejobaddula/DE_case_study
